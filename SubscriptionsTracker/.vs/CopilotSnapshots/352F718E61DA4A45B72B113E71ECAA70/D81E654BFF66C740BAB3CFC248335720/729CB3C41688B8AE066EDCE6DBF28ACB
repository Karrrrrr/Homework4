using System;
using System.Linq;
using Microsoft.Maui.Controls;
using SubscriptionsTracker.ViewModels;
using SubscriptionsTracker.Models;

namespace SubscriptionsTracker.Views
{
    public partial class StatisticsPage : ContentPage
    {
        public StatisticsViewModel ViewModel { get; }

        public StatisticsPage(StatisticsViewModel viewModel)
        {
            ViewModel = viewModel;
            BindingContext = ViewModel;
            Title = "Статистика";
            // hide Shell top bar for this page per design
            Shell.SetNavBarIsVisible(this, false);

            // Header
            var headerGrid = new Grid { ColumnDefinitions = { new ColumnDefinition(GridLength.Star), new ColumnDefinition(GridLength.Auto) }, Padding = new Thickness(16,6) };
            headerGrid.Add(new Label { Text = "Статистика", FontSize = 22, FontAttributes = FontAttributes.Bold, VerticalOptions = LayoutOptions.Center }, 0, 0);
            headerGrid.Add(new Label { Text = DateTime.Now.ToString("d MMMM yyyy г.", new System.Globalization.CultureInfo("ru-RU")), FontSize = 12, VerticalOptions = LayoutOptions.Center, HorizontalOptions = LayoutOptions.End, FontFamily = "OpenSansRegular" }, 1, 0);

            // Summary 2x2 rendered as a unified table with separators
            var summaryGrid = new Grid
            {
                ColumnDefinitions = { new ColumnDefinition(GridLength.Star), new ColumnDefinition(GridLength.Star) },
                RowDefinitions = { new RowDefinition(GridLength.Auto), new RowDefinition(GridLength.Auto) },
                ColumnSpacing = 0,
                RowSpacing = 0,
                Padding = new Thickness(0)
            };
            summaryGrid.Padding = new Thickness(16, 0, 16, 0);

            View MakeCell(string title, string bindingPath, string stringFormat = null)
            {
                // two-row cell: title above, value below
                var cell = new Grid { Padding = new Thickness(12, 12), RowDefinitions = { new RowDefinition(GridLength.Auto), new RowDefinition(GridLength.Auto) } };
                cell.Add(new Label { Text = title, FontSize = 12 }, 0, 0);
                var label = new Label { FontSize = 20, FontAttributes = FontAttributes.Bold };
                if (!string.IsNullOrEmpty(stringFormat))
                    label.SetBinding(Label.TextProperty, new Binding(bindingPath, stringFormat: stringFormat));
                else
                    label.SetBinding(Label.TextProperty, new Binding(bindingPath));
                label.FontFamily = "OpenSansSemibold";
                // place value on second row
                cell.Add(label, 0, 1);
                return cell;
            }

            var card1 = MakeCell("В месяц", "MonthlyTotal", "{0:N0} ₽");
            var card2 = MakeCell("В год", "YearTotal", "{0:N0} ₽");
            var card3 = MakeCell("За 12 месяцев", "Last12Total", "{0:N0} ₽");
            var card4 = MakeCell("За всё время", "AllTimeTotal", "{0:N0} ₽");

            // add cells
            summaryGrid.Add(card1, 0, 0);
            summaryGrid.Add(card2, 1, 0);
            summaryGrid.Add(card3, 0, 1);
            summaryGrid.Add(card4, 1, 1);

            // separators: vertical and horizontal full-width lines
            var vSep = new BoxView { WidthRequest = 1, BackgroundColor = Color.FromArgb("#E6E6E6"), HorizontalOptions = LayoutOptions.End, VerticalOptions = LayoutOptions.Fill };
            summaryGrid.Add(vSep, 0, 0);
            Grid.SetRowSpan(vSep, 2);
            Grid.SetColumn(vSep, 0);
            // horizontal separator
            var hSep = new BoxView { HeightRequest = 1, BackgroundColor = Color.FromArgb("#E6E6E6"), HorizontalOptions = LayoutOptions.Fill, VerticalOptions = LayoutOptions.Start };
            summaryGrid.Add(hSep, 0, 1);
            Grid.SetColumnSpan(hSep, 2);

            // wrap summaryGrid with top and bottom borders so table has outer boundary
            var summaryContainer = new Grid { RowDefinitions = { new RowDefinition(GridLength.Auto), new RowDefinition(GridLength.Auto), new RowDefinition(GridLength.Auto) } };
            var topBorder = new BoxView { HeightRequest = 1, BackgroundColor = Color.FromArgb("#E6E6E6"), HorizontalOptions = LayoutOptions.Fill };
            var bottomBorder = new BoxView { HeightRequest = 1, BackgroundColor = Color.FromArgb("#E6E6E6"), HorizontalOptions = LayoutOptions.Fill };
            summaryContainer.Add(topBorder);
            summaryContainer.Add(summaryGrid);
            summaryContainer.Add(bottomBorder);
            Grid.SetRow(topBorder, 0);
            Grid.SetRow(summaryGrid, 1);
            Grid.SetRow(bottomBorder, 2);

            // Monthly bar chart (simple)
            var chartLabelGrid = new Grid { ColumnDefinitions = { new ColumnDefinition(GridLength.Star), new ColumnDefinition(GridLength.Auto) }, Padding = new Thickness(16, 12, 16, 0) };
            chartLabelGrid.Add(new Label { Text = "Расходы по месяцам", FontSize = 14 }, 0, 0);
            var monthInfo = new Label { Text = DateTime.UtcNow.ToString("MMM yyyy") + " — 0 ₽", FontSize = 12 };
            chartLabelGrid.Add(monthInfo, 1, 0);

            var barsGrid = new Grid { Padding = new Thickness(16, 8, 16, 8) };
            var barsStack = new HorizontalStackLayout { Spacing = 8, VerticalOptions = LayoutOptions.Start, HeightRequest = 120, HorizontalOptions = LayoutOptions.Fill };
            // Will create 12 bars bound to MonthlyBreakdown later in OnAppearing
            for (int i = 0; i < 12; i++)
            {
                var bar = new BoxView { WidthRequest = 18, HeightRequest = 8, BackgroundColor = Color.FromArgb("#E9E9E9"), VerticalOptions = LayoutOptions.End };
                barsStack.Add(bar);
            }

            // Category breakdown
            var catLabel = new Label { Text = "По категориям, в месяц", FontSize = 14, Margin = new Thickness(16, 8, 0, 0) };
            var catStack = new VerticalStackLayout { Spacing = 8, Padding = new Thickness(16, 8, 16, 0) };
            // Will populate category items in OnAppearing

            // Top subscriptions
            var topLabel = new Label { Text = "Самые дорогие, в год", FontSize = 14, Margin = new Thickness(16, 16, 0, 0) };
            var topStack = new VerticalStackLayout { Spacing = 4, Padding = new Thickness(16, 8, 16, 16) };

            var chartToCategoriesSeparator = new BoxView { HeightRequest = 1, BackgroundColor = Color.FromArgb("#E6E6E6"), HorizontalOptions = LayoutOptions.Fill, Margin = new Thickness(16,8,16,0) };

            var main = new VerticalStackLayout { Spacing = 0 };
            main.Add(headerGrid);
            // add the container with outer borders
            main.Add(summaryContainer);
            main.Add(chartLabelGrid);
            // add small spacing between label and chart
            barsStack.Margin = new Thickness(16, 8, 16, 8);
            main.Add(barsStack);
            // separator between chart and categories
            main.Add(chartToCategoriesSeparator);
            main.Add(catLabel);
            main.Add(catStack);
            main.Add(topLabel);
            main.Add(topStack);

            // Bottom navigation bar inside statistics page (custom)
            var bottomBar = BuildBottomBar(isStatistics:true);

            var outer = new Grid();
            outer.RowDefinitions.Add(new RowDefinition(GridLength.Star));
            outer.RowDefinitions.Add(new RowDefinition(GridLength.Auto));
            outer.Add(new ScrollView { Content = main });
            outer.Add(bottomBar);
            Grid.SetRow(bottomBar, 1);

            Content = outer;

            // store references for update
            _barsStack = barsStack;
            _catStack = catStack;
            _topStack = topStack;
            _monthInfo = monthInfo;
        }
        HorizontalStackLayout _barsStack;
        VerticalStackLayout _catStack;
        VerticalStackLayout _topStack;
        Label _monthInfo;
        int _selectedMonthIndex = -1;

        protected override async void OnAppearing()
        {
            base.OnAppearing();
            await ViewModel.LoadAsync(DateTime.UtcNow.Year, DateTime.UtcNow.Month);

            var ru = new System.Globalization.CultureInfo("ru-RU");

            // Rebuild bars as vertical stacks with clickable month info
            _barsStack.Children.Clear();
            var arr = ViewModel.MonthlyBreakdown ?? new decimal[12];
            var max = arr.Length > 0 ? arr.Max() : 0;
            for (int i = 0; i < 12; i++)
            {
                var monthDate = DateTime.UtcNow.AddMonths(i - 11);
                var monthLetter = monthDate.ToString("MMM", ru).Substring(0, 1).ToUpper();

                var box = new BoxView { HeightRequest = 8, BackgroundColor = Color.FromArgb("#E9E9E9"), VerticalOptions = LayoutOptions.End, HorizontalOptions = LayoutOptions.FillAndExpand };
                var lbl = new Label { Text = monthLetter, FontSize = 10, HorizontalOptions = LayoutOptions.Center, TextColor = Color.FromArgb("#6B6B6B") };

                var v = new VerticalStackLayout { Spacing = 6, VerticalOptions = LayoutOptions.EndAndExpand, HorizontalOptions = LayoutOptions.FillAndExpand };
                v.Add(box);
                v.Add(lbl);

                var index = i;
                var tap = new TapGestureRecognizer();
                tap.Tapped += (s, e) => ShowMonthInfo(index, monthDate, arr[index], ru);
                v.GestureRecognizers.Add(tap);

                var height = max > 0 ? 100.0 * (double)(arr[i] / max) : 8.0;
                box.HeightRequest = Math.Max(8, height);
                box.BackgroundColor = (i == 11) ? Color.FromArgb("#2563EB") : Color.FromArgb("#E9E9E9");
                // rounded columns
                box.CornerRadius = 6;
                box.HorizontalOptions = LayoutOptions.FillAndExpand;

                _barsStack.Add(v);
            }

            // initialize month info to latest month
            var latestDate = DateTime.UtcNow;
            var latestAmount = arr.Length > 0 ? arr[^1] : 0;
            _selectedMonthIndex = arr.Length - 1;
            _monthInfo.Text = $"{latestDate.ToString("MMM yyyy", ru)} — {latestAmount:N0} ₽";

            // Categories: proportional top bar and list with separators
            _catStack.Children.Clear();

            if (ViewModel.CategoryStats != null && ViewModel.CategoryStats.Count > 0)
            {
                var catBar = new Grid { HeightRequest = 12, ColumnSpacing = 0 };
                // build columns with separators
                for (int i = 0; i < ViewModel.CategoryStats.Count; i++)
                {
                    var cs = ViewModel.CategoryStats[i];
                    catBar.ColumnDefinitions.Add(new ColumnDefinition(new GridLength((double)cs.Amount, GridUnitType.Star)));
                    if (i < ViewModel.CategoryStats.Count - 1)
                        catBar.ColumnDefinitions.Add(new ColumnDefinition(new GridLength(2, GridUnitType.Absolute)));
                }

                int col = 0;
                for (int i = 0; i < ViewModel.CategoryStats.Count; i++)
                {
                    var cs = ViewModel.CategoryStats[i];
                    var color = CategoryColor(cs.Category);
                    var rect = new BoxView { BackgroundColor = color, CornerRadius = 6 };
                    catBar.Add(rect, col, 0);
                    col++;
                    if (i < ViewModel.CategoryStats.Count - 1)
                    {
                        var sep = new BoxView { BackgroundColor = Colors.White };
                        catBar.Add(sep, col, 0);
                        col++;
                    }
                }

                _catStack.Add(catBar);
            }

            // category rows
            foreach (var cs in ViewModel.CategoryStats)
            {
                var row = new Grid { ColumnDefinitions = { new ColumnDefinition(GridLength.Auto), new ColumnDefinition(GridLength.Star), new ColumnDefinition(GridLength.Auto), new ColumnDefinition(GridLength.Auto) }, Padding = new Thickness(0, 8) };
                var color = CategoryColor(cs.Category);
                row.Add(new BoxView { WidthRequest = 14, HeightRequest = 14, BackgroundColor = color, VerticalOptions = LayoutOptions.Center, CornerRadius = 4 }, 0, 0);
                row.Add(new Label { Text = CategoryToRussian(cs.Category), VerticalOptions = LayoutOptions.Center, Margin = new Thickness(12,0,0,0) }, 1, 0);
                row.Add(new Label { Text = $"{cs.Percent:N0}%", VerticalOptions = LayoutOptions.Center, HorizontalOptions = LayoutOptions.End, Margin = new Thickness(0,0,12,0), TextColor = Color.FromArgb("#6B6B6B") }, 2, 0);
                row.Add(new Label { Text = $"{cs.Amount:N0} ₽", VerticalOptions = LayoutOptions.Center }, 3, 0);
                _catStack.Add(row);
                _catStack.Add(new BoxView { HeightRequest = 1, BackgroundColor = Color.FromArgb("#E6E6E6"), HorizontalOptions = LayoutOptions.Fill });
            }

            // Top subscriptions with separators and spacing
            _topStack.Children.Clear();
            int idx = 1;
            foreach (var t in ViewModel.TopSubscriptions)
            {
                var g = new Grid { ColumnDefinitions = { new ColumnDefinition(GridLength.Auto), new ColumnDefinition(GridLength.Star), new ColumnDefinition(GridLength.Auto) }, Padding = new Thickness(0, 12) };
                g.Add(new Label { Text = idx.ToString(), VerticalOptions = LayoutOptions.Center, TextColor = Color.FromArgb("#6B6B6B") }, 0, 0);
                g.Add(new Label { Text = t.Name, VerticalOptions = LayoutOptions.Center, Margin = new Thickness(12, 0, 0, 0) }, 1, 0);
                g.Add(new Label { Text = $"{t.Amount:N0} ₽", VerticalOptions = LayoutOptions.Center }, 2, 0);
                _topStack.Add(g);
                _topStack.Add(new BoxView { HeightRequest = 1, BackgroundColor = Color.FromArgb("#E6E6E6"), HorizontalOptions = LayoutOptions.Fill });
                idx++;
            }
        }

        void ShowMonthInfo(int index, DateTime monthDate, decimal amount, System.Globalization.CultureInfo ru)
        {
            _selectedMonthIndex = index;
            _monthInfo.Text = $"{monthDate.ToString("MMM yyyy", ru)} — {amount:N0} ₽";
            for (int i = 0; i < _barsStack.Children.Count; i++)
            {
                if (_barsStack.Children[i] is VerticalStackLayout v && v.Children[0] is BoxView b)
                {
                    b.BackgroundColor = (i == index) ? Color.FromArgb("#2563EB") : Color.FromArgb("#E9E9E9");
                }
            }
        }

        Color CategoryColor(Category c) => c switch
        {
            Category.Video => Color.FromArgb("#2563EB"), // primary blue
            Category.Music => Color.FromArgb("#60A5FA"), // lighter blue
            Category.Cloud => Color.FromArgb("#A3C2F9"), // pale blue
            Category.Work => Color.FromArgb("#6B7280"), // gray
            _ => Color.FromArgb("#D1D5DB"),
        };

        string CategoryToRussian(Category c) => c switch
        {
            Category.Video => "Видео",
            Category.Music => "Музыка",
            Category.Cloud => "Облако",
            Category.Work => "Работа",
            _ => "Другое",
        };

        View BuildBottomBar(bool isStatistics)
        {
            // replicate bottom bar structure similar to main page
            var outer = new Grid
            {
                RowDefinitions = { new RowDefinition(GridLength.Auto), new RowDefinition(GridLength.Auto) },
                BackgroundColor = Colors.White
            };

            var border = new BoxView { HeightRequest = 1, BackgroundColor = Color.FromArgb("#E6E6E6"), HorizontalOptions = LayoutOptions.Fill };
            outer.Add(border);

            var grid = new Grid { ColumnDefinitions = { new ColumnDefinition(GridLength.Star), new ColumnDefinition(GridLength.Auto), new ColumnDefinition(GridLength.Star) }, Padding = new Thickness(0, 4), BackgroundColor = Colors.White };

            var left = new VerticalStackLayout { HorizontalOptions = LayoutOptions.Center };
            var leftIndicator = new BoxView
            {
                HeightRequest = 2,
                WidthRequest = 80,
                Margin = new Thickness(0, -9, 0, 0),
                BackgroundColor = isStatistics ? Colors.Transparent : Color.FromArgb("#2563EB"),
                HorizontalOptions = LayoutOptions.Center
            };
            left.Add(leftIndicator);
            var leftIcon = new Image { Source = "subscriptions.png", WidthRequest = 28, HeightRequest = 28, HorizontalOptions = LayoutOptions.Center, Margin = new Thickness(0, 6, 0, 0) };
            left.Add(leftIcon);
            left.Add(new Label { Text = "Подписки", FontSize = 12, TextColor = Color.FromArgb("#6B6B6B"), HorizontalOptions = LayoutOptions.Center });

            var right = new VerticalStackLayout { HorizontalOptions = LayoutOptions.Center };
            var rightIndicator = new BoxView { HeightRequest = 2, WidthRequest = 80, Margin = new Thickness(0, -9, 0, 0), BackgroundColor = isStatistics ? Color.FromArgb("#2563EB") : Colors.Transparent, HorizontalOptions = LayoutOptions.Center };
            var rightIcon = new Image { Source = "statistics.png", WidthRequest = 28, HeightRequest = 28, HorizontalOptions = LayoutOptions.Center, Margin = new Thickness(0, 6, 0, 0) };
            right.Add(rightIndicator);
            right.Add(rightIcon);
            right.Add(new Label { Text = "Статистика", FontSize = 12, TextColor = Color.FromArgb("#6B6B6B"), HorizontalOptions = LayoutOptions.Center });

            var fab = new Button
            {
                Text = "+",
                WidthRequest = 48,
                HeightRequest = 48,
                CornerRadius = 8,
                BackgroundColor = Color.FromArgb("#2563EB"),
                TextColor = Colors.White,
                HorizontalOptions = LayoutOptions.Center,
                VerticalOptions = LayoutOptions.Center,
                FontSize = 24,
                Padding = new Thickness(0)
            };
            fab.Clicked += async (s, e) => { /* placeholder for add action */ };
            fab.ZIndex = 10;

            grid.Add(left, 0, 0);
            grid.Add(fab, 1, 0);
            grid.Add(right, 2, 0);

            var tapLeft = new TapGestureRecognizer();
            tapLeft.Tapped += async (s, e) => await Shell.Current.GoToAsync("//MainPage");
            left.GestureRecognizers.Add(tapLeft);

            var tapRight = new TapGestureRecognizer();
            tapRight.Tapped += async (s, e) => await Shell.Current.GoToAsync("//StatisticsPage");
            right.GestureRecognizers.Add(tapRight);

            outer.Add(grid, 0, 1);
            return outer;
        }
    }
}

